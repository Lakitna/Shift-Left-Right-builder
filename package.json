{
  "name": "shift-left-right-builder",
  "version": "0.0.0",
  "description": "WYSIWYG shift-left/shift-right graph model builder — web app with .png/.svg export and URL-shareable models",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "build:fonts": "node ./scripts/build-font.mjs",
    "start": "tsdown -w",
    "serve:web": "node ./scripts/serve-web.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --shuffle",
    "test:e2e:update": "playwright test --update-snapshots --shuffle",
    "typecheck:tests": "tsc -p tests/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/clean-css": "^4.2.11",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.5",
    "clean-css": "^5.3.3",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "html-minifier-terser": "^7.2.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}